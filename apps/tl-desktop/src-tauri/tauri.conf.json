{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TensorLab",
  "version": "0.2.1",
  "identifier": "org.tensorlab.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "TensorLab",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
