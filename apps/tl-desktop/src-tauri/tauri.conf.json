{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TensorLab",
  "version": "0.3.0",
  "identifier": "org.tensorlab.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "TensorLab",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": [
      "../../../toolbox/control",
      "../../../toolbox/image",
      "../../../toolbox/numerics_btri",
      "../../../toolbox/numerics_gmres",
      "../../../toolbox/numerics_pcg",
      "../../../toolbox/optimization",
      "../../../toolbox/optim_batch",
      "../../../toolbox/optim_extra",
      "../../../toolbox/optim_fmincon",
      "../../../toolbox/optim_lsqlin",
      "../../../toolbox/signal",
      "../../../toolbox/stats",
      "../../../toolbox/stats_extra",
      "../../../toolbox/stats_pdf"
    ],
    "windows": {
      "wix": {
        "language": ["zh-CN"]
      }
    }
  }
}
