{
  "category": "stats",
  "functions": [
    {
      "name": "chi2inv",
      "compare": ["x"],
      "matlab": true,
      "tol": 1e-8,
      "normal": [
        "x=chi2inv(0.5,4);",
        "x=chi2inv(0.95,10);",
        "x=chi2inv(0.05,1);"
      ],
      "boundary": [
        "x=chi2inv(1e-6,4);",
        "x=chi2inv(1-1e-6,4);"
      ],
      "abnormal": [
        "x=chi2inv(0,4);",
        "x=chi2inv(1.1,4);"
      ]
    },
    {
      "name": "iqr",
      "setup": "x=[1 2 3 4 5 6 7 8];",
      "compare": ["y"],
      "matlab": true,
      "tol": 1e-12,
      "normal": [
        "y=iqr(x);",
        "y=iqr([1 1 2 10 10 10]);",
        "y=iqr([-5 -1 0 1 5]);"
      ],
      "boundary": [
        "y=iqr(5);",
        "y=iqr(1:100);"
      ],
      "abnormal": [
        "y=iqr([]);",
        "y=iqr(ones(2,2));"
      ]
    },
    {
      "name": "moment",
      "setup": "x=[1 2 3 4 5];",
      "compare": ["y"],
      "matlab": true,
      "tol": 1e-10,
      "normal": [
        "y=moment(x,2);",
        "y=moment(x,3);",
        "y=moment(x,4);"
      ],
      "boundary": [
        "y=moment(x,1);",
        "y=moment(x,8);"
      ],
      "abnormal": [
        "y=moment(x,0);",
        "y=moment(x,-1);"
      ]
    },
    {
      "name": "normfit",
      "setup": "x=[1 2 3 4 5];",
      "compare": ["muhat", "sigmahat", "muci", "sigmaci"],
      "matlab": true,
      "tol": 1e-8,
      "normal": [
        "[muhat,sigmahat,muci,sigmaci]=normfit(x,0.05);",
        "[muhat,sigmahat,muci,sigmaci]=normfit([2 4 4 4 5 5 7 9],0.1);",
        "[muhat,sigmahat,muci,sigmaci]=normfit([-2 -1 0 1 2 3],0.01);"
      ],
      "boundary": [
        "[muhat,sigmahat,muci,sigmaci]=normfit(x,0.001);",
        "[muhat,sigmahat,muci,sigmaci]=normfit(x,0.5);"
      ],
      "abnormal": [
        "[muhat,sigmahat,muci,sigmaci]=normfit(x,0);",
        "[muhat,sigmahat,muci,sigmaci]=normfit(x,1.1);"
      ]
    },
    {
      "name": "pca",
      "compare": ["latent", "explained"],
      "matlab": true,
      "tol": 1e-8,
      "normal": [
        "[coeff,score,latent,tsquared,explained]=pca([1 2;2 4;3 6;4 8]);",
        "[coeff,score,latent,tsquared,explained]=pca([2 1;3 5;4 2;5 6;6 3]);",
        "[coeff,score,latent,tsquared,explained]=pca([1 0 1;0 1 1;1 1 0;2 1 1]);"
      ],
      "boundary": [
        "[coeff,score,latent,tsquared,explained]=pca([1 2;3 4]);",
        "[coeff,score,latent,tsquared,explained]=pca(reshape(1:40,20,2));"
      ],
      "abnormal": [
        "[coeff,score,latent,tsquared,explained]=pca([1 2]);",
        "[coeff,score,latent,tsquared,explained]=pca([]);"
      ]
    },
    {
      "name": "range",
      "compare": ["y"],
      "matlab": true,
      "tol": 1e-12,
      "normal": [
        "y=range([1 2 3 4 5]);",
        "y=range([-5 0 5]);",
        "y=range([3 3 3 3]);"
      ],
      "boundary": [
        "y=range(5);",
        "y=range(1:100);"
      ],
      "abnormal": [
        "y=range([]);",
        "y=range(ones(2,2));"
      ]
    },
    {
      "name": "ttest",
      "setup": "x=[1 2 3 4 5];",
      "compare": ["h", "p", "ci"],
      "matlab": true,
      "tol": 1e-8,
      "normal": [
        "[h,p,ci]=ttest(x,0,0.05);",
        "[h,p,ci]=ttest(x,3,0.05);",
        "[h,p,ci]=ttest([2 4 4 4 5 5 7 9],4,0.1);"
      ],
      "boundary": [
        "[h,p,ci]=ttest(x,0,0.001);",
        "[h,p,ci]=ttest(x,0,0.5);"
      ],
      "abnormal": [
        "[h,p,ci]=ttest(x,0,0);",
        "[h,p,ci]=ttest(x,0,1.1);"
      ]
    },
    {
      "name": "vartest",
      "setup": "x=[1 2 3 4 5];",
      "compare": ["h", "p", "ci"],
      "matlab": true,
      "tol": 1e-8,
      "normal": [
        "[h,p,ci]=vartest(x,1,0.05);",
        "[h,p,ci]=vartest(x,2,0.1);",
        "[h,p,ci]=vartest([2 4 4 4 5 5 7 9],4,0.05);"
      ],
      "boundary": [
        "[h,p,ci]=vartest(x,1,0.001);",
        "[h,p,ci]=vartest(x,1,0.5);"
      ],
      "abnormal": [
        "[h,p,ci]=vartest(x,0,0.05);",
        "[h,p,ci]=vartest(x,1,1.1);"
      ]
    },
    {
      "name": "zscore",
      "setup": "x=[1 2 3 4 5];",
      "compare": ["z"],
      "matlab": true,
      "tol": 1e-12,
      "normal": [
        "z=zscore(x,0);",
        "z=zscore(x,1);",
        "z=zscore([2 4 4 4 5 5 7 9],0);"
      ],
      "boundary": [
        "z=zscore(5,0);",
        "z=zscore(1:100,1);"
      ],
      "abnormal": [
        "z=zscore(x,2);",
        "z=zscore([],0);"
      ]
    },
    {
      "name": "chi2pdf",
      "compare": ["y"],
      "matlab": true,
      "tol": 1e-10,
      "normal": [
        "y=chi2pdf(1,4);",
        "y=chi2pdf([1 2 3 4],4);",
        "y=chi2pdf(2,1);"
      ],
      "boundary": [
        "y=chi2pdf(0,4);",
        "y=chi2pdf(100,4);"
      ],
      "abnormal": [
        "y=chi2pdf(1,0);",
        "y=chi2pdf(1,-1);"
      ]
    },
    {
      "name": "fcdf",
      "compare": ["y"],
      "matlab": true,
      "tol": 1e-10,
      "normal": [
        "y=fcdf(1,2,3);",
        "y=fcdf([0.5 1 2 4],2,3);",
        "y=fcdf(2,10,20);"
      ],
      "boundary": [
        "y=fcdf(0,2,3);",
        "y=fcdf(100,2,3);"
      ],
      "abnormal": [
        "y=fcdf(1,0,3);",
        "y=fcdf(1,2,-1);"
      ]
    },
    {
      "name": "anova1",
      "compare": ["p"],
      "matlab": true,
      "note": "MATLAB 第二输出为 ANOVA 表 tbl，本项目的 F 统计量无法直接对比，故只比 p",
      "tol": 1e-8,
      "normal": [
        "[p,F]=anova1([1 2 3 4 5 6]',[1 1 1 2 2 2]);",
        "[p,F]=anova1([1 2 3;2 3 4;3 4 5]);",
        "[p,F]=anova1([1 2 3 4 5 6],[1 1 2 2 3 3]);"
      ],
      "boundary": [
        "[p,F]=anova1([1 2;3 4],[1 1 2 2]);",
        "[p,F]=anova1(reshape(1:30,10,3));"
      ],
      "abnormal": [
        "[p,F]=anova1([1 2 3 4]);",
        "[p,F]=anova1([1 2 3 4],[1 1 2]);"
      ]
    },
    {
      "name": "anova2",
      "compare": ["p"],
      "matlab": true,
      "note": "返回顺序与个数已对齐 MATLAB：REPS=1 返回 2 个 p，否则返回 3 个",
      "tol": 1e-8,
      "normal": [
        "p=anova2([1 2;3 4;5 6],1);",
        "p=anova2([1 2 3 4;2 3 4 5;3 4 5 6],2);",
        "p=anova2([1 2 3 4 5 6;2 3 4 5 6 7],3);"
      ],
      "boundary": [
        "p=anova2([1 2;3 4],1);",
        "p=anova2([1 2 3 4 5 6;2 3 4 5 6 7],3);"
      ],
      "abnormal": [
        "p=anova2([1 2;3 4],0);",
        "p=anova2([1 2 3;4 5 6],2);"
      ]
    },
    {
      "name": "glmfit",
      "compare": ["b", "dev"],
      "matlab": true,
      "tol": 1e-6,
      "normal": [
        "X=[1 0;1 1;1 2;1 3;1 4;1 5]; y=[1 2 1 3 2 4]'; [b,dev]=glmfit(X,y,'normal');",
        "X=[1 0;1 1;1 2;1 3;1 4;1 5]; y=[0 0 1 1 1 1]'; [b,dev]=glmfit(X,y,'binomial');",
        "X=[1 0;1 1;1 2;1 3;1 4;1 5]; y=[1 1 2 3 5 8]'; [b,dev]=glmfit(X,y,'poisson');"
      ],
      "boundary": [
        "X=[1 0;1 1]; y=[0 1]'; [b,dev]=glmfit(X,y,'normal');",
        "X=[1 0;1 1;1 2]; y=[0 0 1]'; [b,dev]=glmfit(X,y,'binomial');"
      ],
      "abnormal": [
        "X=[1 0;1 1;1 2]; y=[1 2]'; [b,dev]=glmfit(X,y,'normal');",
        "X=[1 0;1 1;1 2]; y=[1 2 3]'; [b,dev]=glmfit(X,y,'bad');"
      ]
    },
    {
      "name": "kruskalwallis",
      "compare": ["p"],
      "matlab": true,
      "note": "MATLAB 第二输出为 ANOVA 表 tbl（本项目为 H 统计量），故只比 p；另本项目不支持单矩阵多列形式（x(:) 后再判列数）",
      "tol": 1e-8,
      "normal": [
        "[p,H]=kruskalwallis([1 2 3 4 5 6]',[1 1 1 2 2 2]);",
        "[p,H]=kruskalwallis([1 2 3;2 3 4;3 4 5]);",
        "[p,H]=kruskalwallis([1 2 3 4 5 6],[1 1 2 2 3 3]);"
      ],
      "boundary": [
        "[p,H]=kruskalwallis([1 2;3 4],[1 1 2 2]);",
        "[p,H]=kruskalwallis(reshape(1:30,10,3));"
      ],
      "abnormal": [
        "[p,H]=kruskalwallis([1 2 3 4]);",
        "[p,H]=kruskalwallis([1 2 3 4],[1 1 2]);"
      ]
    },
    {
      "name": "mle",
      "setup": "x=[1 2 3 4 5];",
      "compare": ["phat"],
      "matlab": true,
      "tol": 1e-8,
      "normal": [
        "phat=mle(x);",
        "phat=mle(x,'normal');",
        "phat=mle([1 2 4 8],'exponential');"
      ],
      "boundary": [
        "phat=mle([1 2],'normal');",
        "phat=mle([0 1 2 3 4],'poisson');"
      ],
      "abnormal": [
        "phat=mle(x,'bad');",
        "phat=mle([],'normal');"
      ]
    },
    {
      "name": "nlinfit",
      "setup": "X=(0:4)'; y=[1 1.6487 2.7183 4.4817 7.3891]'; modelfun=@(b,x) b(1)*exp(b(2)*x); beta0=[0.5;0.1];",
      "compare": ["beta"],
      "matlab": true,
      "tol": 1e-4,
      "normal": [
        "beta=nlinfit(X,y,modelfun,beta0);",
        "beta=nlinfit(X,2*exp(0.5*X),modelfun,beta0);",
        "beta=nlinfit(X,3*exp(-0.2*X),modelfun,[1;0]);"
      ],
      "boundary": [
        "beta=nlinfit(X(1:3),y(1:3),modelfun,beta0);",
        "beta=nlinfit((0:9)',2*exp(0.3*(0:9)'),modelfun,beta0);"
      ],
      "abnormal": [
        "beta=nlinfit(X,y,modelfun,[0;0]);",
        "beta=nlinfit(X,y(1:3),modelfun,beta0);"
      ]
    }
  ]
}
