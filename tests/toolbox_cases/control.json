{
  "category": "control",
  "functions": [
    {
      "name": "acker",
      "setup": "A=[0 1;-2 -3]; B=[0;1]; p=[-4;-5];",
      "compare": ["K"],
      "matlab": true,
      "tol": 1e-8,
      "normal": [
        "K=acker(A,B,p);",
        "K=acker(A,B,[-1;-2]);",
        "K=acker([0 1;-1 -2],[0;1],[-3;-4]);"
      ],
      "boundary": [
        "K=acker(-1,1,-2);",
        "K=acker([0 1;-2 -3],[0;1],[-10;-20]);"
      ],
      "abnormal": [
        "K=acker(A,B,[-1]);",
        "K=acker([1 0;0 1],[0;0],[-1;-2]);"
      ]
    },
    {
      "name": "allmargin",
      "setup": "sys=tf([1],[1 2 1]);",
      "compare": ["Gm", "Pm", "Wcg", "Wcp"],
      "matlab": false,
      "note": "本项目返回 Gm/Pm/Wcg/Wcp 四个数值，MATLAB 返回结构体，无法直接对比",
      "tol": 1e-4,
      "normal": [
        "[Gm,Pm,Wcg,Wcp]=allmargin(sys);",
        "[Gm,Pm,Wcg,Wcp]=allmargin(tf([1],[1 1 1]));",
        "[Gm,Pm,Wcg,Wcp]=allmargin(tf([1 1],[1 2 3]));"
      ],
      "boundary": [
        "[Gm,Pm,Wcg,Wcp]=allmargin(tf([1],[1]));",
        "[Gm,Pm,Wcg,Wcp]=allmargin(tf([1],[1 0]));"
      ],
      "abnormal": [
        "[Gm,Pm,Wcg,Wcp]=allmargin([]);",
        "[Gm,Pm,Wcg,Wcp]=allmargin(1);"
      ]
    },
    {
      "name": "bode",
      "setup": "sys=tf([1],[1 2 1]); w=logspace(-2,2,20);",
      "compare": ["mag", "phase"],
      "matlab": true,
      "tol": 1e-6,
      "normal": [
        "[mag,phase,wout]=bode(sys,w); mag=squeeze(mag); phase=squeeze(phase);",
        "[mag,phase,wout]=bode(tf([1 1],[1 2 3]),w); mag=squeeze(mag); phase=squeeze(phase);",
        "[mag,phase,wout]=bode(tf([1],[1 1]),w); mag=squeeze(mag); phase=squeeze(phase);"
      ],
      "boundary": [
        "[mag,phase,wout]=bode(sys,0); mag=squeeze(mag); phase=squeeze(phase);",
        "[mag,phase,wout]=bode(sys,100); mag=squeeze(mag); phase=squeeze(phase);"
      ],
      "abnormal": [
        "[mag,phase,wout]=bode(sys,-1); mag=squeeze(mag); phase=squeeze(phase);",
        "[mag,phase,wout]=bode([],w); mag=squeeze(mag); phase=squeeze(phase);"
      ]
    },
    {
      "name": "bodemag",
      "setup": "sys=tf([1],[1 2 1]); w=logspace(-2,2,20);",
      "compare": ["mag"],
      "matlab": true,
      "tol": 1e-6,
      "normal": [
        "mag=squeeze(bodemag(sys,w));",
        "mag=squeeze(bodemag(tf([1 1],[1 2 3]),w));",
        "mag=squeeze(bodemag(tf([1],[1 1]),w));"
      ],
      "boundary": [
        "mag=squeeze(bodemag(sys,0));",
        "mag=squeeze(bodemag(sys,100));"
      ],
      "abnormal": [
        "mag=squeeze(bodemag(sys,-1));",
        "mag=squeeze(bodemag([],w));"
      ]
    },
    {
      "name": "c2d",
      "setup": "sys=tf([1],[1 2 1]);",
      "compare": ["h1", "h2"],
      "matlab": true,
      "tol": 1e-6,
      "normal": [
        "sysd=c2d(sys,0.1); h1=evalfr(sysd,1); h2=evalfr(sysd,0.5);",
        "sysd=c2d(sys,0.1,'tustin'); h1=evalfr(sysd,1); h2=evalfr(sysd,0.5);",
        "sysd=c2d(tf([1 1],[1 2 3]),0.2); h1=evalfr(sysd,1); h2=evalfr(sysd,0.5);"
      ],
      "boundary": [
        "sysd=c2d(sys,0.001); h1=evalfr(sysd,1); h2=evalfr(sysd,0.5);",
        "sysd=c2d(sys,10); h1=evalfr(sysd,1); h2=evalfr(sysd,0.5);"
      ],
      "abnormal": [
        "sysd=c2d(sys,0); h1=evalfr(sysd,1); h2=evalfr(sysd,0.5);",
        "sysd=c2d(sys,0.1,'bad'); h1=evalfr(sysd,1); h2=evalfr(sysd,0.5);"
      ]
    },
    {
      "name": "d2c",
      "setup": "sys=tf([1],[1 2 1]); sysd=c2d(sys,0.1);",
      "compare": ["h1", "h2"],
      "matlab": true,
      "note": "本项目 d2c 要求显式传入采样周期 TS（MATLAB 从模型属性读取）",
      "tol": 1e-4,
      "normal": [
        "sysc=d2c(sysd,0.1); h1=evalfr(sysc,1); h2=evalfr(sysc,0.5);",
        "sysc=d2c(sysd,0.1,'tustin'); h1=evalfr(sysc,1); h2=evalfr(sysc,0.5);",
        "sysc=d2c(c2d(tf([1 1],[1 2 3]),0.2),0.2); h1=evalfr(sysc,1); h2=evalfr(sysc,0.5);"
      ],
      "boundary": [
        "sysc=d2c(c2d(sys,0.001),0.001); h1=evalfr(sysc,1); h2=evalfr(sysc,0.5);",
        "sysc=d2c(c2d(sys,1),1); h1=evalfr(sysc,1); h2=evalfr(sysc,0.5);"
      ],
      "abnormal": [
        "sysc=d2c(sysd,0); h1=evalfr(sysc,1); h2=evalfr(sysc,0.5);",
        "sysc=d2c(sysd,'bad'); h1=evalfr(sysc,1); h2=evalfr(sysc,0.5);"
      ]
    },
    {
      "name": "d2d",
      "setup": "sys=tf([1],[1 2 1]); sysd=c2d(sys,0.1);",
      "compare": ["h1", "h2"],
      "matlab": true,
      "tol": 1e-6,
      "normal": [
        "sd=d2d(sysd,0.1,0.2); h1=evalfr(sd,1); h2=evalfr(sd,0.5);",
        "sd=d2d(sysd,0.1,0.2,'tustin'); h1=evalfr(sd,1); h2=evalfr(sd,0.5);",
        "sd=d2d(c2d(tf([1 1],[1 2 3]),0.2),0.2,0.1); h1=evalfr(sd,1); h2=evalfr(sd,0.5);"
      ],
      "boundary": [
        "sd=d2d(sysd,0.1,0.1); h1=evalfr(sd,1); h2=evalfr(sd,0.5);",
        "sd=d2d(sysd,0.1,1); h1=evalfr(sd,1); h2=evalfr(sd,0.5);"
      ],
      "abnormal": [
        "sd=d2d(sysd,0,0.2); h1=evalfr(sd,1); h2=evalfr(sd,0.5);",
        "sd=d2d(sysd,0.1,0.2,'bad'); h1=evalfr(sd,1); h2=evalfr(sd,0.5);"
      ]
    },
    {
      "name": "dlqr",
      "setup": "A=[1 0.1;0 0.9]; B=[0;0.1]; Q=eye(2); R=1;",
      "compare": ["K", "S", "e"],
      "matlab": true,
      "tol": 1e-6,
      "normal": [
        "[K,S,e]=dlqr(A,B,Q,R);",
        "[K,S,e]=dlqr(A,B,2*Q,1);",
        "[K,S,e]=dlqr([0.9 0.2;0 0.8],[0;1],Q,2);"
      ],
      "boundary": [
        "[K,S,e]=dlqr(A,B,Q,1);",
        "[K,S,e]=dlqr(A,B,Q,10);"
      ],
      "abnormal": [
        "[K,S,e]=dlqr(A,B,Q,0);",
        "[K,S,e]=dlqr(A,B,-Q,1);"
      ]
    },
    {
      "name": "evalfr",
      "setup": "sys=tf([1 2],[1 2 1]);",
      "compare": ["h"],
      "matlab": true,
      "tol": 1e-10,
      "normal": [
        "h=evalfr(sys,1);",
        "h=evalfr(sys,0);",
        "h=evalfr(sys,1+1i);"
      ],
      "boundary": [
        "h=evalfr(sys,0);",
        "h=evalfr(sys,100);"
      ],
      "abnormal": [
        "h=evalfr(sys,-1);",
        "h=evalfr([],1);"
      ]
    },
    {
      "name": "freqresp",
