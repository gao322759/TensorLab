      ],
      "matlab": true,
      "tol": 0,
      "normal": [
        "[L,n]=bwlabel(BW);",
        "[L,n]=bwlabel(BW,4);",
        "[L,n]=bwlabel(BW,8);"
      ],
      "boundary": [
        "[L,n]=bwlabel(false(1),8);",
        "[L,n]=bwlabel(true(3),8);"
      ],
      "abnormal": [
        "[L,n]=bwlabel(BW,3);",
        "[L,n]=bwlabel([],8);"
      ]
    },
    {
      "name": "edge",
      "setup": "A=[1 2 3;4 5 6;7 8 9];",
      "compare": [
