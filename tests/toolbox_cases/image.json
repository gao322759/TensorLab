        "J=imclose(BW,strel('bad',3));"
      ]
    },
    {
      "name": "imcrop",
      "setup": "A=[1 2 3;4 5 6;7 8 9];",
      "compare": [
        "B"
      ],
      "matlab": true,
      "note": "本项目按 RECT=[xmin ymin w h] 的 1-based 像素索引裁剪，不做 MATLAB 的空间坐标外扩",
      "tol": 0,
      "normal": [
        "B=imcrop(A,[1 1 2 2]);",
