{
  "category": "image",
  "functions": [
    {
      "name": "bwareaopen",
      "setup": "BW=logical([0 1 0;1 1 1;0 1 0]);",
      "compare": [
        "y"
      ],
      "matlab": true,
      "tol": 0,
      "normal": [
        "y=bwareaopen(BW,2);",
        "y=bwareaopen(BW,1);",
        "y=bwareaopen(BW,3);"
      ],
      "boundary": [
        "y=bwareaopen(BW,0);",
        "y=bwareaopen(BW,9);"
      ],
      "abnormal": [
        "y=bwareaopen(BW,-1);",
        "y=bwareaopen(BW,2,3);"
      ]
    },
    {
      "name": "bwconncomp",
      "setup": "BW=logical([1 0 0;0 1 1;0 0 1]);",
      "compare": [
        "n"
      ],
      "matlab": true,
      "tol": 0,
      "normal": [
        "s=bwconncomp(BW); n=s.NumObjects;",
        "s=bwconncomp(BW,4); n=s.NumObjects;",
        "s=bwconncomp(BW,8); n=s.NumObjects;"
      ],
      "boundary": [
        "s=bwconncomp(false(1)); n=s.NumObjects;",
        "s=bwconncomp(true(3)); n=s.NumObjects;"
      ],
      "abnormal": [
        "s=bwconncomp(BW,3); n=s.NumObjects;",
        "s=bwconncomp([],4); n=s.NumObjects;"
      ]
    },
    {
      "name": "bwdist",
      "setup": "BW=logical([0 0 0;0 1 0;0 0 0]);",
      "compare": [
        "D"
      ],
      "matlab": true,
      "tol": 0.000001,
      "normal": [
        "D=bwdist(BW);",
        "D=bwdist(logical([1 0 0;0 1 0;0 0 1]));",
        "D=bwdist(true(3));"
      ],
      "boundary": [
        "D=bwdist(true(1));",
        "D=bwdist(logical(ones(5,5)));"
      ],
      "abnormal": [
        "D=bwdist([]);",
        "D=bwdist([1 0;0 1]);"
      ]
    },
    {
      "name": "bwlabel",
      "setup": "BW=logical([1 0 0;0 1 1;0 0 1]);",
      "compare": [
        "L",
