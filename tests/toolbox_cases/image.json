    {
      "name": "rgb2ycbcr",
      "setup": "I=zeros(3,3,3); I(:,:,1)=[1 0 0;0 1 0;0 0 1]; I(:,:,2)=[0 1 0;0 0 1;1 0 0]; I(:,:,3)=[0 0 1;1 0 0;0 1 0];",
      "compare": [
        "Y"
      ],
      "matlab": true,
      "tol": 0.000001,
      "normal": [
        "Y=rgb2ycbcr(I);",
        "Y=rgb2ycbcr(zeros(3,3,3));",
        "Y=rgb2ycbcr(ones(3,3,3));"
      ],
      "boundary": [
        "Y=rgb2ycbcr(zeros(1,1,3));",
        "Y=rgb2ycbcr(ones(5,5,3));"
      ],
      "abnormal": [
        "Y=rgb2ycbcr(zeros(3,3));",
        "Y=rgb2ycbcr([]);"
      ],
      "note": "MATLAB 内部用单精度常数计算，残差约 1e-7"
    },
    {
