{
  "category": "optimization",
  "functions": [
    {
      "name": "optimget",
      "setup": "opts=struct('MaxIter',100,'TolX',1e-6);",
      "compare": ["v"],
      "matlab": true,
      "tol": 1e-12,
      "normal": [
        "v=optimget(opts,'MaxIter');",
        "v=optimget(opts,'TolX');",
        "v=optimget(opts,'Missing',42);"
      ],
      "boundary": [
        "v=optimget(struct(),'Missing',0);",
        "v=optimget(struct(),'Missing',[]);"
      ],
      "abnormal": [
        "v=optimget(opts,'Missing');",
        "v=optimget([],'MaxIter',7);"
      ]
    },
    {
      "name": "fminsearch",
      "compare": ["x", "fval"],
      "matlab": true,
      "tol": 1e-4,
      "normal": [
        "fun=@(x) (x(1)-1)^2+(x(2)+2)^2; [x,fval]=fminsearch(fun,[0;0]);",
        "fun=@(x) 100*(x(2)-x(1)^2)^2+(1-x(1))^2; [x,fval]=fminsearch(fun,[-1.2;1]);",
        "fun=@(x) sum((x-[1;2;3]).^2); [x,fval]=fminsearch(fun,[0;0;0]);"
      ],
      "boundary": [
        "fun=@(x) (x(1)-1)^2+(x(2)+2)^2; [x,fval]=fminsearch(fun,[0;0]);",
        "fun=@(x) (x(1)-1)^2+(x(2)+2)^2; [x,fval]=fminsearch(fun,[-10;-10]);"
      ],
      "abnormal": [
        "fun=@(x) x^2; [x,fval]=fminsearch(fun,0);",
        "fun=@(x) sum(x.^2); [x,fval]=fminsearch(fun,[]);"
      ]
    },
    {
      "name": "lsqnonneg",
      "compare": ["x"],
      "matlab": true,
      "tol": 1e-8,
      "normal": [
        "C=[1 0;0 1;1 1]; d=[1;2;3]; x=lsqnonneg(C,d);",
        "C=[1 2;3 4;5 6]; d=[1;0;1]; x=lsqnonneg(C,d);",
        "C=[1 0 0;0 1 0;0 0 1]; d=[-1;2;-3]; x=lsqnonneg(C,d);"
      ],
      "boundary": [
        "C=1; d=2; x=lsqnonneg(C,d);",
        "C=ones(6,2); d=(1:6)'; x=lsqnonneg(C,d);"
      ],
      "abnormal": [
        "C=[]; d=[]; x=lsqnonneg(C,d);",
        "C=[1 2;3 4]; d=[1]; x=lsqnonneg(C,d);"
      ]
    },
    {
      "name": "fmincon",
      "compare": ["x", "fval"],
      "matlab": true,
      "tol": 1e-4,
      "normal": [
        "fun=@(x) (x(1)-1)^2+(x(2)-2)^2; [x,fval,ef]=fmincon(fun,[0;0],[],[],[],[],[],[],[],[]);",
        "fun=@(x) (x(1)-1)^2+(x(2)-2)^2; [x,fval,ef]=fmincon(fun,[0;0],[1 1],1,[],[],[],[],[],[]);",
        "fun=@(x) (x(1)-5)^2+(x(2)+1)^2; [x,fval,ef]=fmincon(fun,[0;0],[],[],[],[],[0;0],[2;2],[],[]);"
      ],
      "boundary": [
        "fun=@(x) (x-3)^2; [x,fval,ef]=fmincon(fun,0,[],[],[],[],0,10,[],[]);",
        "fun=@(x) (x(1)-1)^2+(x(2)-2)^2; [x,fval,ef]=fmincon(fun,[0;0],[],[],[],[],[0;0],[1;1],[],[]);"
      ],
      "abnormal": [
        "fun=@(x) sum(x.^2); [x,fval,ef]=fmincon(fun,[],[],[],[],[],[],[],[],[]);",
        "fun=@(x) sum(x.^2); [x,fval,ef]=fmincon(fun,[0;0],[],[],[],[],[2;2],[0;0],[],[]);"
      ]
    },
    {
      "name": "lsqlin",
      "compare": ["x", "resnorm"],
      "matlab": true,
      "tol": 1e-6,
      "normal": [
        "C=[1 0;0 1;1 1]; d=[1;2;3]; [x,resnorm,r,ef]=lsqlin(C,d,[],[],[],[],[],[],[],[]);",
        "C=[1 2;3 4;5 6]; d=[1;0;1]; [x,resnorm,r,ef]=lsqlin(C,d,[],[],[],[],[0;0],[1;1],[],[]);",
        "C=[1 0;0 1]; d=[2;3]; [x,resnorm,r,ef]=lsqlin(C,d,[1 1],4,[],[],[],[],[],[]);"
      ],
      "boundary": [
        "C=1; d=2; [x,resnorm,r,ef]=lsqlin(C,d,[],[],[],[],[],[],[],[]);",
        "C=ones(6,2); d=(1:6)'; [x,resnorm,r,ef]=lsqlin(C,d,[],[],[],[],[],[],[],[]);"
      ],
      "abnormal": [
        "C=[]; d=[]; [x,resnorm,r,ef]=lsqlin(C,d,[],[],[],[],[],[],[],[]);",
        "C=[1 0;0 1]; d=[1;2]; [x,resnorm,r,ef]=lsqlin(C,d,[],[],[],[],[2;2],[0;0],[],[]);"
      ]
    },
    {
      "name": "intlinprog",
      "compare": ["x", "fval"],
      "matlab": true,
      "tol": 1e-6,
      "normal": [
        "f=[-1;-2]; intcon=[1;2]; [x,fval,ef,out]=intlinprog(f,intcon,[1 1],4,[],[],[0;0],[2;2],[]);",
        "f=[1;2]; intcon=[1]; [x,fval,ef,out]=intlinprog(f,intcon,[1 1],3,[],[],[0;0],[3;3],[]);",
        "f=[-3;-2;-1]; intcon=[1;2;3]; [x,fval,ef,out]=intlinprog(f,intcon,[1 1 1],5,[],[],[0;0;0],[3;3;3],[]);"
      ],
      "boundary": [
        "f=-1; intcon=1; [x,fval,ef,out]=intlinprog(f,intcon,[],[],[],[],0,3,[]);",
        "f=[-1;-2]; intcon=[1;2]; [x,fval,ef,out]=intlinprog(f,intcon,[1 1],2,[],[],[0;0],[2;2],[]);"
      ],
      "abnormal": [
        "f=[-1]; intcon=[0]; [x,fval,ef,out]=intlinprog(f,intcon,[],[],[],[],[],[]);",
        "f=[-1]; intcon=[2]; [x,fval,ef,out]=intlinprog(f,intcon,[],[],[],[],[],[]);"
      ]
    },
    {
      "name": "ga",
      "compare": ["x", "fval"],
      "matlab": false,
      "tol": 1e-2,
      "normal": [
        "fun=@(x) sum((x-[1;2]).^2); [x,fval]=ga(fun,2);",
        "fun=@(x) sum((x-[1;2]).^2); [x,fval]=ga(fun,2,[],[],[],[],[-2;-2],[2;2]);",
        "fun=@(x) sum((x-[1;2;3]).^2); [x,fval]=ga(fun,3);"
      ],
      "boundary": [
        "fun=@(x) (x-1)^2; [x,fval]=ga(fun,1);",
        "fun=@(x) sum((x-[1;2]).^2); [x,fval]=ga(fun,2,[],[],[],[],[0;0],[1;1]);"
      ],
      "abnormal": [
        "fun=@(x) sum(x.^2); [x,fval]=ga(fun,0);",
        "fun=@(x) sum(x.^2); [x,fval]=ga(fun,2,[],[],[],[],[2;2],[0;0]);"
      ]
    },
    {
      "name": "particleswarm",
      "compare": ["x", "fval"],
      "matlab": false,
      "tol": 1e-2,
      "normal": [
        "fun=@(x) sum((x-[1;2]).^2); [x,fval]=particleswarm(fun,2);",
        "fun=@(x) sum((x-[1;2]).^2); [x,fval]=particleswarm(fun,2,[-2;-2],[2;2]);",
        "fun=@(x) sum((x-[1;2;3]).^2); [x,fval]=particleswarm(fun,3);"
      ],
      "boundary": [
        "fun=@(x) (x-1)^2; [x,fval]=particleswarm(fun,1);",
        "fun=@(x) sum((x-[1;2]).^2); [x,fval]=particleswarm(fun,2,[0;0],[1;1]);"
      ],
      "abnormal": [
        "fun=@(x) sum(x.^2); [x,fval]=particleswarm(fun,0);",
        "fun=@(x) sum(x.^2); [x,fval]=particleswarm(fun,2,[2;2],[0;0]);"
      ]
    },
    {
      "name": "patternsearch",
      "compare": ["x", "fval"],
      "matlab": false,
      "tol": 1e-2,
      "normal": [
        "fun=@(x) sum((x-[1;2]).^2); [x,fval]=patternsearch(fun,[0;0]);",
        "fun=@(x) sum((x-[1;2]).^2); [x,fval]=patternsearch(fun,[0;0],[],[],[],[],[-2;-2],[2;2]);",
        "fun=@(x) sum((x-[1;2;3]).^2); [x,fval]=patternsearch(fun,[0;0;0]);"
      ],
      "boundary": [
        "fun=@(x) (x-1)^2; [x,fval]=patternsearch(fun,0);",
        "fun=@(x) sum((x-[1;2]).^2); [x,fval]=patternsearch(fun,[0;0],[],[],[],[],[0;0],[1;1]);"
      ],
      "abnormal": [
        "fun=@(x) sum(x.^2); [x,fval]=patternsearch(fun,[]);",
        "fun=@(x) sum(x.^2); [x,fval]=patternsearch(fun,[0;0],[],[],[],[],[2;2],[0;0]);"
      ]
    },
    {
      "name": "simulannealbnd",
      "compare": ["x", "fval"],
      "matlab": false,
      "tol": 1e-2,
      "normal": [
        "fun=@(x) sum((x-[1;2]).^2); [x,fval]=simulannealbnd(fun,[0;0]);",
        "fun=@(x) sum((x-[1;2]).^2); [x,fval]=simulannealbnd(fun,[0;0],[-2;-2],[2;2]);",
        "fun=@(x) sum((x-[1;2;3]).^2); [x,fval]=simulannealbnd(fun,[0;0;0]);"
      ],
      "boundary": [
        "fun=@(x) (x-1)^2; [x,fval]=simulannealbnd(fun,0);",
        "fun=@(x) sum((x-[1;2]).^2); [x,fval]=simulannealbnd(fun,[0;0],[0;0],[1;1]);"
      ],
      "abnormal": [
        "fun=@(x) sum(x.^2); [x,fval]=simulannealbnd(fun,[]);",
        "fun=@(x) sum(x.^2); [x,fval]=simulannealbnd(fun,[0;0],[2;2],[0;0]);"
      ]
    }
  ]
}
